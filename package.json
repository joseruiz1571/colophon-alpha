{
  "name": "colophon",
  "version": "0.1.0",
  "description": "A signed, machine-readable record of what an AI agent was allowed to do, what it tried to do, what it was refused, and the evidence behind each of those facts.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "colophon": "./src/cli/index.ts"
  },
  "scripts": {
    "colophon": "bun run src/cli/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "demo": "bun run scripts/demo.ts",
    "policy:test": "opa test policy/ -v",
    "policy:fmt": "opa fmt --diff policy/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^4.0.0",
    "uuid": "^14.0.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/uuid": "^11.0.0",
    "ajv-cli": "^5.0.0",
    "typescript": "^5.7.2"
  }
}
